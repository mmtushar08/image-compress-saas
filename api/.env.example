# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://shrinkix.com
LOG_LEVEL=info

# Database
# DB_CLIENT selects the Knex dialect: "sqlite3" (default, dev/test) or "pg" (production).
# When DB_CLIENT=pg, DATABASE_URL must be set.
DB_CLIENT=sqlite3
DATABASE_URL=postgres://shrinkix:shrinkix_dev@postgres:5432/shrinkix

# Redis (sessions / rate limits / job queue — Phase 7)
REDIS_URL=redis://redis:6379

# Docker Compose
POSTGRES_PASSWORD=change_me_in_production

# VPS Deployment Credentials (NEVER COMMIT THESE)
VPS_HOST=your_vps_ip_or_hostname
VPS_PORT=22
VPS_USER=your_vps_user
VPS_PASSWORD=your_vps_password

# Security
ADMIN_API_KEY=your_secure_admin_key_here
JWT_SECRET=your_secure_jwt_secret_here

# Notifications
ADMIN_EMAIL=admin@shrinkix.com

# Email (SMTP) — leave blank to mock/log emails in dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Shrinkix Support <support@shrinkix.com>"

# Third Party Services
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
